{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "portable-editor",
  "version": "0.1.0",
  "identifier": "com.juan.portableeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "portable-editor",
        "width": 1100,
        "height": 750,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "txt", "md", "markdown", "log", "json", "yaml", "yml", "toml", "ini", "conf",
          "js", "mjs", "cjs", "jsx", "ts", "tsx", "css", "scss", "less", "html", "htm",
          "xml", "svg", "rs", "py", "go", "java", "kt", "c", "h", "cpp", "hpp", "cs",
          "rb", "php", "sh", "zsh", "bash", "sql", "lua", "vim", "csv"
        ],
        "name": "Text and source files",
        "description": "Archivos de texto y código fuente",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
